<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ══════════════════════════════════════════════════════
       COLOUR SYSTEM — Pure Dark Aesthetic
       No purple, no blue-violet gradients.
       Palette: near-black surfaces + green/red semantics + off-white text.
  ══════════════════════════════════════════════════════ -->

  <!-- Surfaces -->
  <SolidColorBrush x:Key="BrushBgDeep"        Color="#FF080808" />
  <SolidColorBrush x:Key="BrushBgSurface"     Color="#FF101010" />
  <SolidColorBrush x:Key="BrushBgCard"        Color="#FF181818" />
  <SolidColorBrush x:Key="BrushBorder"        Color="#FF282828" />
  <SolidColorBrush x:Key="BrushBorderHover"   Color="#FF3C3C3C" />

  <!-- Semantics — green = active/good, red = locked/danger -->
  <SolidColorBrush x:Key="BrushGreen"         Color="#FF22C55E" />
  <SolidColorBrush x:Key="BrushRed"           Color="#FFEF4444" />
  <SolidColorBrush x:Key="BrushAmber"         Color="#FFF59E0B" />

  <!-- Text hierarchy -->
  <SolidColorBrush x:Key="BrushTextPrimary"   Color="#FFF5F5F5" />
  <SolidColorBrush x:Key="BrushTextSecondary" Color="#FF8A8A8A" />
  <SolidColorBrush x:Key="BrushTextMuted"     Color="#FF484848" />

  <!-- Aliases for legacy references -->
  <SolidColorBrush x:Key="BrushAccent"        Color="#FF22C55E" />
  <SolidColorBrush x:Key="BrushSuccess"       Color="#FF22C55E" />
  <SolidColorBrush x:Key="BrushDanger"        Color="#FFEF4444" />

  <!-- Header gradient — just dark to slightly less dark -->
  <LinearGradientBrush x:Key="BrushHeaderGrad" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF060606" Offset="0" />
    <GradientStop Color="#FF111111" Offset="1" />
  </LinearGradientBrush>

  <!-- Subtle card gradient — gives depth without colour -->
  <LinearGradientBrush x:Key="BrushCardGrad" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF1E1E1E" Offset="0" />
    <GradientStop Color="#FF141414" Offset="1" />
  </LinearGradientBrush>

  <!-- ══════════════════════════════════════════════════════
       TYPOGRAPHY
  ══════════════════════════════════════════════════════ -->
  <FontFamily x:Key="FontUI">Segoe UI, Segoe UI Variable Display, Arial</FontFamily>

  <!-- ══════════════════════════════════════════════════════
       WINDOW CHROME BUTTONS
  ══════════════════════════════════════════════════════ -->
  <Style x:Key="ChromeButton" TargetType="Button">
    <Setter Property="Width"           Value="40" />
    <Setter Property="Height"          Value="32" />
    <Setter Property="Background"      Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground"      Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="FontFamily"      Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize"        Value="10" />
    <Setter Property="Cursor"          Value="Hand" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF202020" />
              <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF2C2C2C" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#FFB91C1C" />
        <Setter Property="Foreground" Value="#FFF5F5F5" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ══════════════════════════════════════════════════════
       MAIN TOGGLE BUTTON — ENABLED STATE
       Dark charcoal face, green glow ring only.
  ══════════════════════════════════════════════════════ -->
  <Style x:Key="MainToggleButton" TargetType="Button">
    <Setter Property="Width"           Value="152" />
    <Setter Property="Height"          Value="152" />
    <Setter Property="Cursor"          Value="Hand" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily"      Value="{StaticResource FontUI}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <!-- Outer glow — green, soft -->
            <Ellipse x:Name="GlowRing" Width="152" Height="152" Opacity="0">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="#4422C55E" Offset="0.55" />
                  <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>

            <!-- Outer border ring -->
            <Ellipse x:Name="Ring" Width="140" Height="140"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     StrokeThickness="1.5">
              <Ellipse.Stroke>
                <SolidColorBrush Color="#FF2C2C2C" />
              </Ellipse.Stroke>
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#FF1E1E1E" Offset="0" />
                  <GradientStop Color="#FF141414" Offset="1" />
                </LinearGradientBrush>
              </Ellipse.Fill>
              <Ellipse.Effect>
                <DropShadowEffect Color="#FF22C55E" BlurRadius="22"
                                  ShadowDepth="0" Opacity="0.18" />
              </Ellipse.Effect>
            </Ellipse>

            <!-- Content -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="⌨" FontSize="34"
                         HorizontalAlignment="Center"
                         Foreground="#FFF5F5F5" Margin="0,0,0,8" />
              <TextBlock Text="{TemplateBinding Content}"
                         FontSize="10" FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="{StaticResource BrushTextSecondary}" />
            </StackPanel>
          </Grid>

          <ControlTemplate.Triggers>
            <!-- Hover: show green glow ring, accent ring border -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="GlowRing" Property="Opacity" Value="1" />
              <Setter TargetName="Ring" Property="Stroke">
                <Setter.Value>
                  <SolidColorBrush Color="#FF22C55E" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <!-- Pressed: shrink slightly -->
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Ring" Property="Width"  Value="132" />
              <Setter TargetName="Ring" Property="Height" Value="132" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════════════════════════════════════════════
       MAIN TOGGLE BUTTON — LOCKED STATE
       Same dark face, but red glow + red ring accent.
  ══════════════════════════════════════════════════════ -->
  <Style x:Key="MainToggleButtonDanger" TargetType="Button">
    <Setter Property="Width"           Value="152" />
    <Setter Property="Height"          Value="152" />
    <Setter Property="Cursor"          Value="Hand" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily"      Value="{StaticResource FontUI}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <!-- Outer glow — red -->
            <Ellipse x:Name="GlowRing" Width="152" Height="152" Opacity="0.7">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="#44EF4444" Offset="0.55" />
                  <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>

            <!-- Dark face, red ring border -->
            <Ellipse x:Name="Ring" Width="140" Height="140"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     StrokeThickness="1.5">
              <Ellipse.Stroke>
                <SolidColorBrush Color="#FFEF4444" />
              </Ellipse.Stroke>
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#FF1E1E1E" Offset="0" />
                  <GradientStop Color="#FF141414" Offset="1" />
                </LinearGradientBrush>
              </Ellipse.Fill>
              <Ellipse.Effect>
                <DropShadowEffect Color="#FFEF4444" BlurRadius="26"
                                  ShadowDepth="0" Opacity="0.32" />
              </Ellipse.Effect>
            </Ellipse>

            <!-- Content -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="&#128274;" FontSize="30"
                         HorizontalAlignment="Center"
                         Foreground="#FFF5F5F5" Margin="0,0,0,8" />
              <TextBlock Text="{TemplateBinding Content}"
                         FontSize="10" FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="{StaticResource BrushTextSecondary}" />
            </StackPanel>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="GlowRing" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Ring" Property="Width"  Value="132" />
              <Setter TargetName="Ring" Property="Height" Value="132" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════════════════════════════════════════════
       DARK COMBO BOX
  ══════════════════════════════════════════════════════ -->
  <Style x:Key="DarkComboBox" TargetType="ComboBox">
    <Setter Property="Background"      Value="#FF181818" />
    <Setter Property="Foreground"      Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height"          Value="30" />
    <Setter Property="Padding"         Value="10,4" />
    <Setter Property="FontFamily"      Value="{StaticResource FontUI}" />
    <Setter Property="FontSize"        Value="12" />
    <Setter Property="Cursor"          Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="▾"
                           Foreground="{StaticResource BrushTextMuted}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="11" />
                <Popup x:Name="PART_Popup"
                       Grid.Column="0"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       Placement="Bottom"
                       AllowsTransparency="True">
                  <Border Background="#FF1A1A1A"
                          BorderBrush="{StaticResource BrushBorder}"
                          BorderThickness="1" CornerRadius="6" Margin="0,3,0,0">
                    <Border.Effect>
                      <DropShadowEffect Color="#FF000000" BlurRadius="16"
                                        ShadowDepth="4" Opacity="0.6" />
                    </Border.Effect>
                    <ScrollViewer MaxHeight="180">
                      <ItemsPresenter />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
            </Border>
            <ToggleButton
              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
              Opacity="0" IsHitTestVisible="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush"
                      Value="{StaticResource BrushBorderHover}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush"
                      Value="{StaticResource BrushTextSecondary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ComboBoxItem">
          <Setter Property="Background"  Value="Transparent" />
          <Setter Property="Foreground"  Value="{StaticResource BrushTextPrimary}" />
          <Setter Property="Padding"     Value="10,7" />
          <Setter Property="FontFamily"  Value="{StaticResource FontUI}" />
          <Setter Property="FontSize"    Value="12" />
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#FF242424" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="#FF242424" />
              <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════════════════════════════════════════════
       GHOST ICON BUTTON
  ══════════════════════════════════════════════════════ -->
  <Style x:Key="GhostIconButton" TargetType="Button">
    <Setter Property="Background"      Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor"          Value="Hand" />
    <Setter Property="Padding"         Value="8,5" />
    <Setter Property="FontFamily"      Value="{StaticResource FontUI}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF1E1E1E" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF282828" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════════════════════════════════════════════
       STATUS DOT
  ══════════════════════════════════════════════════════ -->
  <Style x:Key="StatusDot" TargetType="Ellipse">
    <Setter Property="Width"             Value="8" />
    <Setter Property="Height"            Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
