<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ══════════════════════════════════════════════════════
       COLOUR PALETTE  (literal hex — no Color StaticResource on SolidColorBrush)
  ══════════════════════════════════════════════════════ -->
  <SolidColorBrush x:Key="BrushBgDeep"        Color="#FF0D0D1A" />
  <SolidColorBrush x:Key="BrushBgSurface"     Color="#FF15152A" />
  <SolidColorBrush x:Key="BrushBgCard"        Color="#FF1E1E38" />
  <SolidColorBrush x:Key="BrushBorder"        Color="#FF2A2A4A" />
  <SolidColorBrush x:Key="BrushAccent"        Color="#FF4FC3F7" />
  <SolidColorBrush x:Key="BrushSuccess"       Color="#FF4CAF50" />
  <SolidColorBrush x:Key="BrushDanger"        Color="#FFEF5350" />
  <SolidColorBrush x:Key="BrushTextPrimary"   Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="BrushTextSecondary" Color="#FF8B8FAB" />
  <SolidColorBrush x:Key="BrushTextMuted"     Color="#FF555577" />

  <!-- Gradients -->
  <LinearGradientBrush x:Key="BrushAccentGrad" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF4FC3F7" Offset="0" />
    <GradientStop Color="#FF7C4DFF" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="BrushDangerGrad" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FFEF5350" Offset="0" />
    <GradientStop Color="#FFFF7043" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="BrushHeaderGrad" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF0D0D1A" Offset="0" />
    <GradientStop Color="#FF15152A" Offset="1" />
  </LinearGradientBrush>

  <!-- ══════════════════════════════════════════════════════
       TYPOGRAPHY
  ══════════════════════════════════════════════════════ -->
  <FontFamily x:Key="FontUI">Segoe UI, Segoe UI Variable Display, Arial</FontFamily>

  <!-- ══════════════════════════════════════════════════════
       WINDOW CHROME BUTTON STYLE
  ══════════════════════════════════════════════════════ -->
  <Style x:Key="ChromeButton" TargetType="Button">
    <Setter Property="Width"           Value="40" />
    <Setter Property="Height"          Value="32" />
    <Setter Property="Background"      Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground"      Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="FontFamily"      Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize"        Value="10" />
    <Setter Property="Cursor"          Value="Hand" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
              <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#FFE81123" />
        <Setter Property="Foreground" Value="White" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ══════════════════════════════════════════════════════
       TOGGLE BUTTON — ENABLED STATE (Blue)
  ══════════════════════════════════════════════════════ -->
  <Style x:Key="MainToggleButton" TargetType="Button">
    <Setter Property="Width"           Value="160" />
    <Setter Property="Height"          Value="160" />
    <Setter Property="Cursor"          Value="Hand" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily"      Value="{StaticResource FontUI}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <!-- Outer glow ring -->
            <Ellipse x:Name="GlowRing" Width="160" Height="160" Opacity="0">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="#664FC3F7" Offset="0.6" />
                  <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <!-- Button face -->
            <Ellipse x:Name="BtnFace" Width="140" Height="140"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.8,1">
                  <GradientStop Color="#FF4FC3F7" Offset="0" />
                  <GradientStop Color="#FF7C4DFF" Offset="1" />
                </LinearGradientBrush>
              </Ellipse.Fill>
              <Ellipse.Effect>
                <DropShadowEffect Color="#FF4FC3F7" BlurRadius="24" ShadowDepth="0" Opacity="0.5" />
              </Ellipse.Effect>
            </Ellipse>
            <!-- Icon + label -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="⌨" FontSize="36"
                         HorizontalAlignment="Center"
                         Foreground="White" Margin="0,0,0,6" />
              <TextBlock Text="{TemplateBinding Content}"
                         FontSize="11" FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="#DDFFFFFF" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="GlowRing" Property="Opacity" Value="1" />
              <Setter TargetName="BtnFace" Property="Width"  Value="144" />
              <Setter TargetName="BtnFace" Property="Height" Value="144" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="BtnFace" Property="Width"  Value="132" />
              <Setter TargetName="BtnFace" Property="Height" Value="132" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════════════════════════════════════════════
       TOGGLE BUTTON — DISABLED/LOCKED STATE (Red)
  ══════════════════════════════════════════════════════ -->
  <Style x:Key="MainToggleButtonDanger" TargetType="Button">
    <Setter Property="Width"           Value="160" />
    <Setter Property="Height"          Value="160" />
    <Setter Property="Cursor"          Value="Hand" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily"      Value="{StaticResource FontUI}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Ellipse x:Name="GlowRing" Width="160" Height="160" Opacity="0.6">
              <Ellipse.Fill>
                <RadialGradientBrush>
                  <GradientStop Color="#66EF5350" Offset="0.6" />
                  <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="BtnFace" Width="140" Height="140"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.8,1">
                  <GradientStop Color="#FFEF5350" Offset="0" />
                  <GradientStop Color="#FFFF7043" Offset="1" />
                </LinearGradientBrush>
              </Ellipse.Fill>
              <Ellipse.Effect>
                <DropShadowEffect Color="#FFEF5350" BlurRadius="28" ShadowDepth="0" Opacity="0.65" />
              </Ellipse.Effect>
            </Ellipse>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="&#128274;" FontSize="32"
                         HorizontalAlignment="Center"
                         Foreground="White" Margin="0,0,0,6" />
              <TextBlock Text="{TemplateBinding Content}"
                         FontSize="11" FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="#DDFFFFFF" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="GlowRing" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="BtnFace" Property="Width"  Value="132" />
              <Setter TargetName="BtnFace" Property="Height" Value="132" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════════════════════════════════════════════
       DARK COMBO BOX
  ══════════════════════════════════════════════════════ -->
  <Style x:Key="DarkComboBox" TargetType="ComboBox">
    <Setter Property="Background"      Value="#FF1E1E38" />
    <Setter Property="Foreground"      Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Height"          Value="32" />
    <Setter Property="Padding"         Value="10,4" />
    <Setter Property="FontFamily"      Value="{StaticResource FontUI}" />
    <Setter Property="FontSize"        Value="12" />
    <Setter Property="Cursor"          Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="▾"
                           Foreground="{StaticResource BrushTextSecondary}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                <Popup x:Name="PART_Popup"
                       Grid.Column="0"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       Placement="Bottom"
                       AllowsTransparency="True">
                  <Border Background="#FF1E1E38"
                          BorderBrush="{StaticResource BrushBorder}"
                          BorderThickness="1" CornerRadius="8" Margin="0,2,0,0">
                    <ScrollViewer MaxHeight="200">
                      <ItemsPresenter />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
            </Border>
            <ToggleButton Grid.Column="0"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          Opacity="0" IsHitTestVisible="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ComboBoxItem">
          <Setter Property="Background"  Value="Transparent" />
          <Setter Property="Foreground"  Value="{StaticResource BrushTextPrimary}" />
          <Setter Property="Padding"     Value="10,6" />
          <Setter Property="FontFamily"  Value="{StaticResource FontUI}" />
          <Setter Property="FontSize"    Value="12" />
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#22FFFFFF" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="#334FC3F7" />
              <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════════════════════════════════════════════
       GHOST ICON BUTTON  (GitHub link)
  ══════════════════════════════════════════════════════ -->
  <Style x:Key="GhostIconButton" TargetType="Button">
    <Setter Property="Background"      Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor"          Value="Hand" />
    <Setter Property="Padding"         Value="8,4" />
    <Setter Property="FontFamily"      Value="{StaticResource FontUI}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ══════════════════════════════════════════════════════
       STATUS DOT
  ══════════════════════════════════════════════════════ -->
  <Style x:Key="StatusDot" TargetType="Ellipse">
    <Setter Property="Width"            Value="10" />
    <Setter Property="Height"           Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
