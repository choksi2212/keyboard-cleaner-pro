<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KeyboardCleanerPro</RootNamespace>
    <AssemblyName>KeyboardCleanerPro</AssemblyName>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Keyboard Cleaner Pro</Product>
    <Company>Manas Choksi</Company>
    <Copyright>Copyright © 2025 Manas Choksi</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <!-- Publish settings -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeyboardCleanerPro.Core\KeyboardCleanerPro.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon (taskbar, Alt+Tab, window chrome) -->
    <ApplicationDefinition Update="App.xaml" />
    <Resource Include="Resources\logo.png" />
  </ItemGroup>

</Project>
