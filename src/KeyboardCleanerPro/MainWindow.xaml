<Window x:Class="KeyboardCleanerPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:KeyboardCleanerPro.Converters"
        Title="Keyboard Cleaner Pro"
        Width="480" Height="380"
        MinWidth="480" MinHeight="380"
        MaxWidth="480" MaxHeight="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDeep}"
        WindowStyle="None"
        AllowsTransparency="True"
        Icon="Resources/logo.ico">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40"
                  ResizeBorderThickness="0"
                  GlassFrameThickness="0"
                  UseAeroCaptionButtons="False"
                  CornerRadius="10" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <conv:BoolToVisibilityConverter   x:Key="BoolToVis" />
    <conv:InverseBoolToVisibility     x:Key="InvBoolToVis" />
    <conv:StateToStatusTextConverter  x:Key="StateToStatusText" />
    <conv:StateToStatusColorConverter x:Key="StateToStatusColor" />
    <conv:StateToButtonStyleConverter x:Key="StateToButtonStyle" />
    <conv:StateToButtonTextConverter  x:Key="StateToButtonText" />
    <conv:TimeSpanToDisplayConverter  x:Key="TimeSpanToDisplay" />
    <BooleanToVisibilityConverter     x:Key="NativeBoolToVis" />
  </Window.Resources>

  <Border CornerRadius="10"
          Background="{StaticResource BrushBgDeep}"
          BorderBrush="{StaticResource BrushBorder}"
          BorderThickness="1"
          ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="40" />
      </Grid.RowDefinitions>

      <!-- ══════════════════════════════════════════
           TITLE BAR — named so code-behind attaches DragMove only here
      ══════════════════════════════════════════ -->
      <Border x:Name="TitleBar" Grid.Row="0"
              Background="{StaticResource BrushHeaderGrad}"
              CornerRadius="10,10,0,0"
              BorderBrush="{StaticResource BrushBorder}"
              BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="12,0,0,0">
            <Image Source="Resources/logo.ico"
                   Width="20" Height="20"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Margin="0,0,9,0" />
            <TextBlock Text="Keyboard Cleaner Pro"
                       FontFamily="{StaticResource FontUI}"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextPrimary}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <Border Background="#FF181818"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="4"
                    Padding="5,1" VerticalAlignment="Center">
              <TextBlock Text="v1.0.1" FontSize="9"
                         FontFamily="{StaticResource FontUI}"
                         Foreground="{StaticResource BrushTextMuted}" />
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal"
                      WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="&#xE921;" Style="{StaticResource ChromeButton}"
                    ToolTip="Minimize" Click="MinimizeButton_Click" />
            <Button Content="&#xE8BB;" Style="{StaticResource ChromeCloseButton}"
                    ToolTip="Close" Click="CloseButton_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ══════════════════════════════════════════
           CONTENT
      ══════════════════════════════════════════ -->
      <Grid Grid.Row="1" Margin="20,12,20,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Status strip -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1" CornerRadius="8" Padding="12,7">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0" Style="{StaticResource StatusDot}" Margin="0,0,8,0">
              <Ellipse.Fill>
                <SolidColorBrush Color="{Binding CurrentState,
                                   Converter={StaticResource StateToStatusColor}}" />
              </Ellipse.Fill>
            </Ellipse>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding CurrentState, Converter={StaticResource StateToStatusText}}"
                         FontFamily="{StaticResource FontUI}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource BrushTextPrimary}" />
              <TextBlock Text="{Binding DeviceName}"
                         FontFamily="{StaticResource FontUI}" FontSize="11"
                         Foreground="{StaticResource BrushTextSecondary}"
                         TextTrimming="CharacterEllipsis" MaxWidth="280" />
            </StackPanel>
            <Border Grid.Column="2" Background="#FF1A1A1A"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                    CornerRadius="4" Padding="7,3"
                    Visibility="{Binding DeviceDetected, Converter={StaticResource NativeBoolToVis}}">
              <TextBlock Text="{Binding ConnectionType}"
                         FontFamily="{StaticResource FontUI}" FontSize="10" FontWeight="SemiBold"
                         Foreground="{StaticResource BrushTextSecondary}" />
            </Border>
          </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             TOGGLE BUTTON AREA
             Design: one Grid cell with two stacked Buttons.
             Only ONE is Visible at a time (the other is Collapsed).
             A collapsed element has no hit area so there is no overlap.
             DragMove is attached to TitleBar only, so clicks here always fire.
        ══════════════════════════════════════════ -->
        <Grid Grid.Row="1">

          <!-- GREEN button: keyboard enabled state -->
          <Button Command="{Binding ToggleCommand}"
                  IsEnabled="{Binding CanToggle}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="152" Height="152"
                  Cursor="Hand"
                  BorderThickness="0"
                  Background="Transparent"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  Style="{StaticResource MainToggleButton}">
            <Button.Visibility>
              <Binding Path="IsKeyboardEnabled" Converter="{StaticResource NativeBoolToVis}" />
            </Button.Visibility>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
              <TextBlock Text="⌨" FontSize="34" HorizontalAlignment="Center"
                         Foreground="#FFF5F5F5" Margin="0,0,0,8" />
              <TextBlock Text="{Binding ToggleButtonText}"
                         FontFamily="{StaticResource FontUI}"
                         FontSize="10" FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="{StaticResource BrushTextSecondary}" />
            </StackPanel>
          </Button>

          <!-- RED button: keyboard locked state -->
          <Button Command="{Binding ToggleCommand}"
                  IsEnabled="{Binding CanToggle}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Width="152" Height="152"
                  Cursor="Hand"
                  BorderThickness="0"
                  Background="Transparent"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  Style="{StaticResource MainToggleButtonDanger}">
            <Button.Visibility>
              <Binding Path="IsKeyboardEnabled" Converter="{StaticResource InvBoolToVis}" />
            </Button.Visibility>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
              <TextBlock Text="&#128274;" FontSize="30" HorizontalAlignment="Center"
                         Foreground="#FFF5F5F5" Margin="0,0,0,8" />
              <TextBlock Text="{Binding ToggleButtonText}"
                         FontFamily="{StaticResource FontUI}"
                         FontSize="10" FontWeight="SemiBold"
                         HorizontalAlignment="Center"
                         Foreground="{StaticResource BrushTextSecondary}" />
            </StackPanel>
          </Button>

          <!-- Auto-unlock countdown pill -->
          <Border Background="#FF141414"
                  BorderBrush="{StaticResource BrushBorder}"
                  BorderThickness="1" CornerRadius="6" Padding="12,4"
                  HorizontalAlignment="Center" VerticalAlignment="Bottom"
                  Margin="0,0,0,4"
                  IsHitTestVisible="False"
                  Visibility="{Binding IsTimerActive, Converter={StaticResource NativeBoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="auto-unlock  "
                         FontFamily="{StaticResource FontUI}" FontSize="11"
                         Foreground="{StaticResource BrushTextMuted}" />
              <TextBlock Text="{Binding RemainingTime, Converter={StaticResource TimeSpanToDisplay}}"
                         FontFamily="{StaticResource FontUI}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource BrushRed}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- Bottom controls -->
        <Grid Grid.Row="2" Margin="0,2,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="140" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Text="{Binding ErrorMessage}"
                     FontFamily="{StaticResource FontUI}" FontSize="11"
                     Foreground="{StaticResource BrushRed}"
                     TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="230"
                     Visibility="{Binding HasError, Converter={StaticResource NativeBoolToVis}}" />
          <TextBlock Grid.Column="1" Text="auto-unlock"
                     FontFamily="{StaticResource FontUI}" FontSize="11"
                     Foreground="{StaticResource BrushTextMuted}"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox Grid.Column="2"
                    Style="{StaticResource DarkComboBox}"
                    ItemsSource="{Binding TimerOptions}"
                    SelectedItem="{Binding SelectedTimerMinutes}"
                    IsEnabled="{Binding IsKeyboardEnabled}"
                    DisplayMemberPath="Display" />
        </Grid>
      </Grid>

      <!-- ══════════════════════════════════════════
           FOOTER
      ══════════════════════════════════════════ -->
      <Border Grid.Row="2"
              Background="{StaticResource BrushBgSurface}"
              BorderBrush="{StaticResource BrushBorder}"
              BorderThickness="0,1,0,0"
              CornerRadius="0,0,10,10">
        <Grid Margin="14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Developed by "
                       FontFamily="{StaticResource FontUI}" FontSize="11"
                       Foreground="{StaticResource BrushTextMuted}" />
            <TextBlock Text="Manas Choksi"
                       FontFamily="{StaticResource FontUI}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextSecondary}" />
          </StackPanel>
          <Button Grid.Column="1"
                  Style="{StaticResource GhostIconButton}"
                  ToolTip="View source on GitHub"
                  Click="GitHubButton_Click" Padding="8,5"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                <Canvas Width="24" Height="24">
                  <Path Fill="{StaticResource BrushTextSecondary}"
                        Data="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
                </Canvas>
              </Viewbox>
              <TextBlock Text="Source Code"
                         FontFamily="{StaticResource FontUI}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
