<Window x:Class="KeyboardCleanerPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KeyboardCleanerPro.ViewModels"
        xmlns:conv="clr-namespace:KeyboardCleanerPro.Converters"
        Title="Keyboard Cleaner Pro"
        Width="520" Height="400"
        MinWidth="520" MinHeight="400"
        MaxWidth="520" MaxHeight="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDeep}"
        WindowStyle="None"
        AllowsTransparency="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40"
                  ResizeBorderThickness="0"
                  GlassFrameThickness="0"
                  UseAeroCaptionButtons="False"
                  CornerRadius="12" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <conv:BoolToVisibilityConverter   x:Key="BoolToVis" />
    <conv:InverseBoolToVisibility     x:Key="InvBoolToVis" />
    <conv:StateToStatusTextConverter  x:Key="StateToStatusText" />
    <conv:StateToStatusColorConverter x:Key="StateToStatusColor" />
    <conv:StateToButtonStyleConverter x:Key="StateToButtonStyle" />
    <conv:StateToButtonTextConverter  x:Key="StateToButtonText" />
    <conv:TimeSpanToDisplayConverter  x:Key="TimeSpanToDisplay" />
    <BooleanToVisibilityConverter     x:Key="NativeBoolToVis" />
  </Window.Resources>

  <Border CornerRadius="12"
          Background="{StaticResource BrushBgDeep}"
          BorderBrush="{StaticResource BrushBorder}"
          BorderThickness="1"
          ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />   <!-- Title bar -->
        <RowDefinition Height="*" />    <!-- Content -->
        <RowDefinition Height="44" />   <!-- Footer -->
      </Grid.RowDefinitions>

      <!-- ══════════════════════════════════════════════════
           TITLE BAR
      ══════════════════════════════════════════════════ -->
      <Border Grid.Row="0"
              Background="{StaticResource BrushHeaderGrad}"
              CornerRadius="12,12,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- App identity -->
          <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Margin="16,0,0,0">
            <TextBlock Text="⌨"
                       FontSize="16"
                       Foreground="{StaticResource BrushAccent}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <TextBlock Text="Keyboard Cleaner Pro"
                       FontFamily="{StaticResource FontUI}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextPrimary}"
                       VerticalAlignment="Center" />
            <Border Background="#22FFFFFF"
                    CornerRadius="4"
                    Padding="5,1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
              <TextBlock Text="v1.0"
                         FontSize="10"
                         FontFamily="{StaticResource FontUI}"
                         Foreground="{StaticResource BrushTextSecondary}" />
            </Border>
          </StackPanel>

          <!-- Chrome buttons -->
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="&#xE921;"
                    Style="{StaticResource ChromeButton}"
                    ToolTip="Minimize"
                    Click="MinimizeButton_Click" />
            <Button Content="&#xE8BB;"
                    Style="{StaticResource ChromeCloseButton}"
                    ToolTip="Close"
                    Click="CloseButton_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ══════════════════════════════════════════════════
           MAIN CONTENT
      ══════════════════════════════════════════════════ -->
      <Grid Grid.Row="1" Margin="24,16,24,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />  <!-- Status strip -->
          <RowDefinition Height="*" />     <!-- Toggle button -->
          <RowDefinition Height="Auto" />  <!-- Controls row  -->
        </Grid.RowDefinitions>

        <!-- STATUS STRIP -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status dot -->
            <Ellipse Grid.Column="0"
                     Style="{StaticResource StatusDot}"
                     Margin="0,0,10,0">
              <Ellipse.Fill>
                <SolidColorBrush Color="{Binding CurrentState, Converter={StaticResource StateToStatusColor}}" />
              </Ellipse.Fill>
            </Ellipse>

            <!-- Status text + device name -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding CurrentState, Converter={StaticResource StateToStatusText}}"
                         FontFamily="{StaticResource FontUI}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource BrushTextPrimary}" />
              <TextBlock Text="{Binding DeviceName}"
                         FontFamily="{StaticResource FontUI}"
                         FontSize="11"
                         Foreground="{StaticResource BrushTextSecondary}"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="260" />
            </StackPanel>

            <!-- Connection type badge -->
            <Border Grid.Column="2"
                    Background="#22FFFFFF"
                    CornerRadius="5"
                    Padding="7,3"
                    Visibility="{Binding DeviceDetected, Converter={StaticResource NativeBoolToVis}}">
              <TextBlock Text="{Binding ConnectionType}"
                         FontFamily="{StaticResource FontUI}"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource BrushAccent}" />
            </Border>
          </Grid>
        </Border>

        <!-- TOGGLE BUTTON AREA -->
        <Grid Grid.Row="1">
          <!-- Enable state button -->
          <Button x:Name="ToggleEnabledBtn"
                  Style="{StaticResource MainToggleButton}"
                  Content="{Binding ToggleButtonText}"
                  Command="{Binding ToggleCommand}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsEnabled="{Binding CanToggle}"
                  Visibility="{Binding IsKeyboardEnabled, Converter={StaticResource NativeBoolToVis}}" />

          <!-- Disabled state button (danger style) -->
          <Button x:Name="ToggleDisabledBtn"
                  Style="{StaticResource MainToggleButtonDanger}"
                  Content="{Binding ToggleButtonText}"
                  Command="{Binding ToggleCommand}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsEnabled="{Binding CanToggle}">
            <Button.Visibility>
              <Binding Path="IsKeyboardEnabled" Converter="{StaticResource InvBoolToVis}" />
            </Button.Visibility>
          </Button>

          <!-- Timer countdown overlay (shown when keyboard is locked) -->
          <Border Background="#CC0D0D1A"
                  CornerRadius="10"
                  Padding="14,8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Bottom"
                  Margin="0,0,0,4"
                  Visibility="{Binding IsTimerActive, Converter={StaticResource NativeBoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⏱ Auto-unlock in "
                         FontFamily="{StaticResource FontUI}"
                         FontSize="12"
                         Foreground="{StaticResource BrushTextSecondary}" />
              <TextBlock Text="{Binding RemainingTime, Converter={StaticResource TimeSpanToDisplay}}"
                         FontFamily="{StaticResource FontUI}"
                         FontSize="12"
                         FontWeight="Bold"
                         Foreground="{StaticResource BrushDanger}" />
            </StackPanel>
          </Border>

          <!-- Spinner while detecting/toggling -->
          <TextBlock Text="Processing..."
                     FontFamily="{StaticResource FontUI}"
                     FontSize="12"
                     Foreground="{StaticResource BrushTextSecondary}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,4"
                     Visibility="{Binding IsBusy, Converter={StaticResource NativeBoolToVis}}" />
        </Grid>

        <!-- CONTROLS ROW (Timer selector) -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="160" />
          </Grid.ColumnDefinitions>

          <!-- Error message -->
          <TextBlock Grid.Column="0"
                     Text="{Binding ErrorMessage}"
                     FontFamily="{StaticResource FontUI}"
                     FontSize="11"
                     Foreground="{StaticResource BrushDanger}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center"
                     MaxWidth="260"
                     Visibility="{Binding HasError, Converter={StaticResource NativeBoolToVis}}" />

          <!-- Timer label -->
          <TextBlock Grid.Column="1"
                     Text="Auto-unlock:"
                     FontFamily="{StaticResource FontUI}"
                     FontSize="11"
                     Foreground="{StaticResource BrushTextSecondary}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />

          <!-- Timer duration combo -->
          <ComboBox Grid.Column="2"
                    Style="{StaticResource DarkComboBox}"
                    ItemsSource="{Binding TimerOptions}"
                    SelectedItem="{Binding SelectedTimerMinutes}"
                    IsEnabled="{Binding IsKeyboardEnabled}"
                    DisplayMemberPath="Display" />
        </Grid>
      </Grid>

      <!-- ══════════════════════════════════════════════════
           FOOTER
      ══════════════════════════════════════════════════ -->
      <Border Grid.Row="2"
              Background="#0AFFFFFF"
              BorderBrush="{StaticResource BrushBorder}"
              BorderThickness="0,1,0,0"
              CornerRadius="0,0,12,12">
        <Grid Margin="16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Developed by -->
          <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <TextBlock Text="Developed by "
                       FontFamily="{StaticResource FontUI}"
                       FontSize="11"
                       Foreground="{StaticResource BrushTextMuted}" />
            <TextBlock Text="Manas Choksi"
                       FontFamily="{StaticResource FontUI}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextSecondary}" />
          </StackPanel>

          <!-- GitHub button -->
          <Button Grid.Column="1"
                  Style="{StaticResource GhostIconButton}"
                  ToolTip="View source on GitHub"
                  Click="GitHubButton_Click"
                  Padding="8,6">
            <StackPanel Orientation="Horizontal">
              <!-- GitHub SVG path rendered via Path shape -->
              <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                <Canvas Width="24" Height="24">
                  <Path Fill="{StaticResource BrushTextSecondary}"
                        Data="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
                </Canvas>
              </Viewbox>
              <TextBlock Text="Source Code"
                         FontFamily="{StaticResource FontUI}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource BrushTextSecondary}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>
